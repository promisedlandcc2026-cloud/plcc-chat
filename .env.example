# Same Supabase project as PLCC Vault / PLCC Connect (public values only)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Where Supabase sends sign-in links back to (this app's address)
VITE_AUTH_REDIRECT_URL=https://plcc-chat.vercel.app/auth/callback
# Show "Text me a code" sign-in (same as Connect)
VITE_SMS_SIGNIN_ENABLED=true

# Server only: the PLCC Vault this app talks to
VAULT_API_ORIGIN=https://plcc-opal.vercel.app
